LEA: MACRO(ra,eti)
	    or ra,r0,low(eti)
	    or.u ra,ra,high(eti)
     ENDMACRO
PUSH: MACRO(ra)
        subu r30,r30,4
        st ra,r30,0
      ENDMACRO
LOAD: MACRO (ra, eti)
		LEA (ra, eti)
		ld ra, ra, r0
	 ENDMACRO
POP: MACRO(ra)
        ld ra,r30,0
        addu r30,r30,4
     ENDMACRO

org 0x10


LongCad:
        PUSH(r1);
        ld r12, r30, 4;                  r12 <- Puntero a la cadena
        or r29, r0, r0;                  Inicio el contador a cero

SIGUELCAD:
        ld.bu r2, r12, r29;              Cargo elemento apuntado por r12, r2 <- mem(r12)
        cmp r7, r2, r0;                  Vemos si se acaba la lista
        bb1 eq, r7, FINLCAD;             Si se acaba, vamos a acabar la subrutina

        addu r29, r29, 1;                Sumamos uno al contador
        br SIGUELCAD;                    Seguimos con la cadena
FINLCAD:
        POP(r1)
        jmp(r1)


LeeBit:
		PUSH(r1)
		ld r20, r30, 4;					 r20 <- Puntero a MapaBits
		ld r15, r30, 8;					 r15 <- NumBit

		divu r16, r15, 8;				 r16 <- r15/8, esto el byte dentro del mapa
		addu r20, r20, r16;				 Apuntamos a el byte
		ld.bu r19, r20, r0;				 r20 <- Cargamos el contenido del byte

		mulu r16, r16, 8;
		subu r17, r15, r16;				 r17 <- NumBit % 8, asi sacas la posición dentro del byte
		xor r17, r17, 7;				 Como está en orden mayor a menor, hay que invertirlo
		or r18, r0, 1;					 Iniciamos a 1 un registro para meterle el desplazamiento en el byte y la anchura

		mak r18, r18, 0<5>;				 En r18 hay un 1 en la posición 5, anchura de la extracción
		addu r18, r17, r18;				 Añado la posición del bit,como es un número entre 0 y , ocupa solo tres bits, no toca el bit 5 con el 1
		extu r29, r19, r18;				 Extraemos el bit en r29 directamente

		POP(r1)
		jmp(r1)

CoincidenCad:
        PUSH(r1)
        ld r20, r30, 4;                  r20 <- Puntero a cadena1
        ld r21, r30, 8;                  r20 <- Puntero a cadena2
        or r29, r0, r0 ;                 Iniciamos contador
SIGUECOINCAD:
        ld.bu r10, r20, r29;             Cargamos caracter de cadena 1
        ld.bu r11, r21, r29;             Cargamos caracter de cadena 2

        cmp r7, r10, r11;                Vemos si son iguales
        bb1 ne, r7, FINCOINCAD;          Si no son iguales hemos acabado

        cmp r7, r10, r0;                 Ya sabemos que son iguales, vemos si hemos acabado, con uno vale porque son iguales
        bb1 eq, r7, FINCOINCAD;          Si ambos osn 0, hemos agotado ambas, y cubrimos también si ambas son vacías

        addu r29, r29, 1;                 Aumentamos contador
        br SIGUECOINCAD;                 Iteramos de nuevo
FINCOINCAD:
        POP(r1);
        jmp(r1);


BuscaCar:
		PUSH(r1);							NOTA TEMPORAL, REVISAR PORQUE NO HAY COMPROBACIÓN DE DATOS VÁLIDOS, ASUME QUE FROM <= TO.
		ld r14, r30, 4;					 r14 <- c, el caracter a buscar
		ld r20, r30, 8;					 r20 <- puntero a ref, es por dirección

		ld r10, r30, 12;				 r10 <- from
		ld r11, r30, 16;				 r11 <- to

		or r29, r10,r0;					 r29 <- Inicio contador de movimiento ya en from, porque luego lo tendre que sumar

		addu r12, r20, r10;				 r12 <- ref[from], apunta a donde tenemos que empezar a buscar
		addu r13, r20, r11;				 r13 <- ref[to], apunta a la posición en la que paramos, esta no se mira, la ultima mirada es ref[to-1]

SigueBusca:
		cmp r7, r12, r13;
		bb1 eq, r7, NoEncontrado;		 Si he llegado al final, acabo

		ld.bu r2, r12, 0;				 Cargamos el char apuntado para comprobarlo
		cmp r7, r2, r14;				 Veo si el apuntado es C
		bb1 eq, r7, FinBusca;

		addu r29, r29, 1;				 Aumentamos contador
		addu r12, r12, 1;
		br SigueBusca;
NoEncontrado:
		or r29, r11, r0
FinBusca:
		POP(r1)
		jmp(r1)



Comprime:
		PUSH(r1)
		PUSH(r31)
		or r31, r30, r30;
		ld r20, r31, 8;					 r20 <- *texto
		PUSH(r20)

		bsr LongCad

		addu r30, r30, 4;				 Limpio pila
		addu r29, r29, 3;				 Redondea hacia arriba
		and r29, r29, 0xFFFC;			 Limpio los dos últimos bits
		addu r29, r29, 12;				 Reservo espacio para desplazamiento en texto, en pilaZona3 y en el mapa de bits
		subu r30, r30, r29;				 Reservo variables local

		ld r20, r31, 8;
		or r4, r0, r0
LLena_M:
		cmp r7, r4, 8
		bb1 eq, r7, Acaba_M
		ld.bu r2, r20, r4
		st.b r2, r30, r4
		addu r4, r4, 1
		br LLena_M
Acaba_M:
		st r4, r31, -4;				     Nuevo desp de texto
		st r4, r31, -8;				     Nuevo desp de pilaZona3
		st r0, r31, -12;				 NumBit, ya estan todas las variables inicializadas
LLenado:
		ld r20, r31, 8
		ld r10, r31, -4
		ld.bu r2, r20, r10
		cmp r7,r2, r0;					 Vemos si hemos acabado texto
		bb1 eq, r7, FinLlenado

		ld r12, r31, -12
		divu r13, r12, 8
		mulu r14, r13, 8
		subu r12, r12, r14;				 Preparamos el %8

		cmp r7, r12, r0;				 Vemos si hay que inicializar
		bb1 ne, r7, NoInicia
		ld r22, r31, 12
		addu r22, r22, 5;				 Me salto la cabecera
		st.b r0, r22, r13
NoInicia:
		subu r30, r30, 4;				 Creo una variable local donde ira el valor de JJ
		or r23, r30, r30;				 En r23 meto el puntero que usara BuscaMax para meter JJ
		
		PUSH(r23)
		PUSH(r10)
		PUSH(r20)

		bsr BuscaMax
		
		addu r30, r30, 12;				 Limpio *texto,el desplazamiento y *JJ, el valor está en la siguiente, porque en una instrucción es más rápido aunque luego tenga que recuperarlo
		POP(r23)

		ld r20, r31, 8
		ld r10, r31, -4
		ld r11, r31, -8;
		ld r12, r31, -12;

		cmp r7, r29, 0x04
		bb1 ge, r7, Compr

		ld.bu r2, r20, r10
		st.b r2, r30, r11

		addu r10, r10, 1
		addu r11, r11, 1
		addu r12, r12, 1;				 Avanzamos los desplazamientos

		st r10, r31, -4
		st r11, r31, -8
		st r12, r31, -12;				 Guardamos todo

		br LLenado
Compr:
		extu r24, r23, 8<8>;			 Segundo byte
		st.b r23, r30, r11
		addu r11, r11, 1
		st.b r24, r30, r11;				 Guardo la dir P, media palabra

		addu r11, r11, 1
		st.b r29, r30, r11;				 Guardo un byte con L
		
		addu r11, r11, 1;				 Avanzo 3 el *pilaZona3
		addu r10, r10, r29;				 Avanzo L el *texto
		st r10, r31, -4
		st r11, r31, -8


		ld r22, r31, 12
		addu r22, r22, 5

		PUSH(r12)
		PUSH(r22)

		bsr PoneBitA1

		addu r30, r30, 8;				 Limpio pila
		ld r12, r31, -12;				 Numbit
		addu r12, r12, 1;				 Avanzo NumBit
		st r12, r31, -12;				 Guardo

		br LLenado
FinLlenado:
		ld r22, r31, 12;				 *Comprimido
		ld r10, r31, -4;				 Desplazamiento texto
		extu r11, r10, 8<8>
		st.b r10, r22, 0;				 Guardo primer byte del tamaño de texto
		st.b r11, r22, 1;				 Guardo segundo byte del tamaño de texto

		or r3, r0, 1;					 Creo un 1, que será M
		st.b r3, r22, 2;

		ld r12, r31, -12;
		addu r12, r12, 7;				 Redondeo hacia arriba el númuero de bytes
		divu r29, r12, 8;				 Saco el numero de bytes de Mapa de bits
		addu r29, r29, 5;				 + 5 de cabecera

		extu r28, r29, 8<8>;
		st.b r29, r22, 3;				 Guardo primer byte de el tamaño de cabecera + mapa de bits
		st.b r28, r22, 4;				 El segundo
		addu r22, r22, r29;				 *cmrpdo a final de mapa de bits
		
		ld r11, r31, -8
		addu r29, r29, r11;				 Valor de retorno ya listo, todos los byts de cmrpdo
		or r4, r0, r0;
Vaciado:
		cmp r7, r4, r11
		bb1 eq, r7, FinVaciado
		ld.bu r2, r30, r4
		st.b r2, r22, r4
		addu r4, r4, 1
		br Vaciado
FinVaciado:
		or r30, r31, r31
		POP(r31)
		POP(r1)
		jmp(r1)

		

		


		


Descomprime:
		PUSH(r1)
		PUSH(r31)
		or r31, r30, r30; 				creo el marco de pila
		ld r21, r30, 8; 				* a comp
		ld r22, r30, 12;				* a desc	
		or r29, r0, r0; 				contador de la cadena
		ld.bu r4, r21, 2; 				valor de M bits a contar 
		ld.bu r5, r21, 3; 				parte baja del desplazamiento
		ld.bu r6, r21, 4;				parte alta del desplazamiento
		mulu r6,r6,256; 				conversión
		addu r5,r5,r6;					juntamos tamaño del desplazamiento a hacer
		addu r23,r21,r5; 				* a donde se encuentra la zona de datos
		mulu r4,r4,8; 					tamaño de bits a copiar
		or r15, r0, r0; 				contador de caracteres iniciales
SIGUE_BUCLE:
		ld.bu r6,r23,r15;
		st.b r6, r22,r15;				basicamente un move del primer caracter (byte) a desc
		addu r15, r15, 1; 				incrementamos el contador
		addu r29, r29, 1;
		cmp r7, r15, r4;
		bb1 ne, r7, SIGUE_BUCLE; 		si no es igual a 8*m (osea copio los 8*m caractere) sigue en el bucle
		addu r22, r22, r4;				avazamos el * a donde se encuentra después de haber copiado los caracteres
		addu r23, r23, r4; 				actualizamos el puntero después de haber copiado los primeros caracteres
		ld.bu r8, r21, r0;				parte alta del desplazamiento
		ld.bu r9, r21, 1; 				parte alta del desplazamiento
		mulu r9,r9,256;
		addu r9,r9,r8; 					ahora tenemos en r9 el tamaño del texto original(para comparar con r29 y saber si está bien o mal)
		addu r24, r21, 5;				* al mapa de bits
		or r15, r0, r0; 				contador reciclado para numbit
BUCLE:
		cmp r7, r29, r9; 				comparamos si tienen el mismo para saber si ha llegado al final de la cadena
		bb1 ge, r7, FIN_DESC;			controlo desbordamiento
		PUSH(r9)
		PUSH(r29)
		PUSH(r22)
		PUSH(r23)
		PUSH(r15)
		PUSH(r24);						guardamos en pila los valores que requerimos
		bsr LeeBit;
		or r10, r29, r0
		POP(r24)
		POP(r15)
		POP(r23)
		POP(r22)
		POP(r29)				
		POP(r9);						recuperamos parametros
		addu r15, r15, 1
		cmp r7, r10, r0
		bb1 eq, r7, Copia_Byte; 	
		ld.bu r5, r23, r0;				obtengo parte baja de la posicion/reciclo r5
		ld.bu r6, r23, 1; 				obtengo parte alta de la posicion/reciclo r6
		mulu r6, r6, 256; 				conversion
		addu r5, r5, r6; 				obtengo la posicion real
		ld.bu r8, r23, 2; 				obtengo el 3er byte que contiene la longitud de la referencia
		ld r25, r30, 12; 				obtengo la zona de inicio de desc(*)
		addu r25, r25, r5; 				voy a donde me mande la posición
		or r3, r0, r0; 					creo un contador
BUCLE_UNO:
		ld.bu r2, r25, r3;
		st.b r2, r22, r3;				copio y lo primero de desc y lo mando al final con el desplazamiento del contador(así mantengo actualizado el puntero de r22 y r25 indirectamente)
		addu r3, r3, 1;					incremento contador
		cmp r7, r3, r8;
		bb1 ne, r7, BUCLE_UNO
		addu r23, r23, 3; 				incremento en 3 los bytes que leyó
		addu r22, r22, r3
		addu r29, r29, r3
		br BUCLE
Copia_Byte:
		ld.bu r4,r23,r0;
		st.b r4,r22,r0;					copio de r23 a r22(el bit a descomprime) el bit/reciclo r4
		addu r23, r23, 1
		addu r22, r22, 1; 				actualizamos el valor de los punteros
		addu r29, r29, 1; 				actualizo contador de palabras
		br BUCLE
FIN_DESC:
		st.b r0, r22, 0; 				añade el "\0" al final que es lo que pide
		POP(r31)
		POP(r1)
		jmp(r1)

		
Verifica:
		PUSH(r1)
		PUSH(r31)
		or r31, r30, r30; 				creo marco de pila
		ld r20, r30, 8;					*texto
		ld r21, r30, 12; 				*long 1
		ld r22, r30, 16;				*long 2
		or r15, r0, r0;					contador LO	
		or r23, r20, r0
Bucle_pila:
		ld.b r3, r23, r0;				leemos el primer byte(nuestro caso base es que sea "\0")
		cmp r7, r3, r0;					si ha llegado a leer todo el texto finaliza, es decir r3="\0"
		bb1 eq, r7, FIN_CALC
		addu r15, r15, 1;				actualizamos el contador
		addu r23,r23,1;					actualizamos puntero
		br Bucle_pila
FIN_CALC:
		st r15, r21, r0;				almacenamos el tamaño del texto original(LO)
		addu r16, r15, 5;				almacenamos el tamaño en bytes(cabecera+LO)
		addu r8, r15, 7;
		divu r8, r8, 8
		subu r8, r8, 1;					aquí ya tenemos el tamaño del mapa de bits
		addu r8, r8, r16;				tamaño en caso peor para pilacom
		addu r9, r15, 1;				espacio para pilades
		addu r8, r8, 3;
		and r8, r8, 0xFFFC;				espacio alineado a palabra de pilacom
		addu r9, r9, 3
		and r9, r9, 0xFFFC;				espacio alineado a palabra de pilades
		subu r30, r30, r9; 				espacio para pilades
		or r25, r30, r0;				direccion donde empieza pilades
		subu r30, r30, r8;				espacio pilacom
		or r26, r30, r0;				direccion donde empieza pilacom
		PUSH(r25);						pongo en pila la direccion de pilades
		PUSH(r26);						pongo en pila la direccion de pilacom
		PUSH(r26);						pilacom
		PUSH(r20); 						pongo el texto en la pila
		bsr Comprime
		addu r30, r30, 8;				bajo el sp
		POP(r26)
		POP(r25)
		PUSH(r25)
		PUSH(r26)
		bsr Descomprime
		addu r30, r30, 8;				bajo sp
		POP(r25)
		ld r23, r31, 16;				obtengo *long2
		st r29, r23, r0;				almaceno en *long2
		ld r21, r31, 12;				volvemos a obtener *long 1
		ld r5, r21, r0;					obtenemos el valor de long 1
		cmp r7, r29, r5;				comparamos si son iguales
		bb1 ne, r7, Es_menos
		ld r21, r31, 8;					volvemos a obtener el texto original
		PUSH(r25)
		PUSH(r21)
		bsr CoincidenCad
		addu r30, r30, 8;				bajo sp 
		ld r22, r31, 12;				volvemos a obtener *long 1
		ld r5, r22, r0;					obtenemos el valor de long 1
		cmp r7, r29, r5;				si son iguales en tamaño entonces son iguales según coincidencad
		bb1 eq, r7, Es_igual
		subu r29, r0, 2;					almacena en r29 un -2
		br Fin_Ver
Es_menos:
		subu r29, r0, 1;					almacena en r29 un -1
		br Fin_Ver
Es_igual:
		or r29, r0, r0;						almacena en r29 un 0
		br Fin_Ver

Fin_Ver:
		or r30, r31, r31
		POP(r31)
		POP(r1)
		jmp(r1)


PoneBitA1:
		PUSH(r1)
		ld r20,r30,4; 					cargo a r20 la dirección de donde se encuentran los bytes
		ld r15,r30,8; 					cargo el entero al registro 15

		divu r16,r15,8; 				averiguo en cual byte se encuentra el bit
		addu r20,r20,r16
		ld.bu r19, r20, r0
		or r18,r0,r0
		addu r18, r18, 1
		mak r18, r18,0<5>


		addu r16,r16,1
		mulu r16,r16,8
		subu r16,r16,1
		
		subu r17, r16,r15
		addu r18,r17,r18
		set r19, r19, r18
		st.b r19, r20, r0

		POP(r1)
		jmp(r1)
		
		

;
; Debe incorporar este fichero con TODAS sus l neas, sin modificar
; ninguna de ellas, al final de su archivo CDV24.ens
;
; Este aviso se refiere tambi n a las l neas de comentario
;
;
;; Grupo:    230340 - Thu Oct 23 10:57:22 CEST 2025

BuscaMax:
	PUSH (r1)
	PUSH (r31)
	or   r31, r30, 0
	or   r28, r0, 0x30B0
	PUSH (r28)

	ld   r10, r31, 8;  REF
	ld   r11, r31, 12; MAX
	ld   r12, r31, 16; Dir(JJ)

	sub  r5, r0, 1		; guarda -1 en *JJ por si no se
	st   r5, r12, 0		; encuentran coincidencias

	addu r27, r0, r0  ; P
	addu r28, r0, r0  ; L

BucBM:
	ld.bu r20, r10, r11	; C=REF(max)

				; Reserva registros que
				; necesita conservar
	PUSH (r28) 	    	; L
	PUSH (r11)	    	; MAX

	     		    	; Par metros de BuscaCar
	PUSH (r27)	    	; P
	PUSH (r10)	    	; REF
	PUSH (r20)	   	; C
	bsr  BuscaCar
	POP  (r20)
	POP  (r10)
	POP  (r27)

	POP  (r11)		; Recupera registros
	POP  (r28)	        ; salvaguardados

	cmp  r5, r29, r11	; nuevo P es >= MAX ??
	bb1  hs, r5, finBM
	addu r27, r29, r0	; P = nuevo P
	
	addu r13, r10, r27	; *REF(P)
	addu r14, r10, r11 	; *REF(max)

	PUSH (r11)     		; Reserva registros que
	PUSH (r10)		; necesita conservar
	PUSH (r28)
	PUSH (r27)
	
	PUSH (r14)		; Par metros de CoincidenCad
	PUSH (r13)
	bsr  CoincidenCad
	POP  (r13)
	POP  (r14)
	
	POP  (r27)		; Recupera registros
	POP  (r28)		; salvaguardados
	POP  (r10)
	POP  (r11)

	cmp r5, r29, r28	; Comprueba si longitud > L
	bb1 le, r5, contBM	; Si no lo es, contin a
	cmp r5, r29, 255	; Comprueba si longitud > 255
	bb1 le, r5, noLimBM	; Si no lo es, contin a
	addu r29, r0, 255	; Si lo es, limita su valor a 255
	
noLimBM:
	addu r28, r29, r0	; actualiza L
	ld   r12, r31, 16	; Dir(JJ)
	st   r27, r12, r0	; actualiza P en *JJ
	bb1 ge, r5, finBM	; Si coincidencia >= 255 termina
contBM:
	addu r27, r27, 1	; Pasa al siguiente car cter
	cmp  r5, r27, r11	; Es P>=max ?
	bb1  hs, r5, finBM
	
	br   BucBM   		; Nueva b squeda del primer car cter

finBM:
	addu r29, r28, r0	; asigna L al valor de retorno r29
	  
	or   r27, r0, 0x5D9
	POP  (r28)

	or   r30, r31, 0
	POP  (r31)
	POP  (r1)
	jmp  (r1)
;; Grupo:    230340