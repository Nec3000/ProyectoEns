LEA: MACRO(ra,eti)
	    or ra,r0,low(eti)
	    or.u ra,ra,high(eti)
     ENDMACRO
PUSH: MACRO(ra)
        subu r30,r30,4
        st ra,r30,0
      ENDMACRO
LOAD: MACRO (ra, eti)
		LEA (ra, eti)
		ld ra, ra, r0
	 ENDMACRO
POP: MACRO(ra)
        ld ra,r30,0
        addu r30,r30,4
     ENDMACRO
	 org 0x00000010


LongCad:
        PUSH(r1);
        ld r12, r30, 4;                  r12 <- Puntero a la cadena
        or r29, r0, r0;                  Inicio el contador a cero

SIGUELCAD:
        ld.bu r2, r12, r29;              Cargo elemento apuntado por r12, r2 <- mem(r12)
        cmp r7, r2, r0;                  Vemos si se acaba la lista
        bb1 eq, r7, FINLCAD;             Si se acaba, vamos a acabar la subrutina

        addu r29, r29, 1;                Sumamos uno al contador
        br SIGUELCAD;                    Seguimos con la cadena
FINLCAD:
        POP(r1)
        jmp(r1)


LeeBit:
		PUSH(r1)
		ld r20, r30, 4;					 r20 <- Puntero a MapaBits
		ld r15, r30, 8;					 r15 <- NumBit

		divu r16, r15, 8;				 r16 <- r15/8, esto el byte dentro del mapa
		addu r20, r20, r16;				 Apuntamos a el byte
		ld.bu r19, r20, r0;				 r20 <- Cargamos el contenido del byte

		mulu r16, r16, 8;
		subu r17, r15, r16;				 r17 <- NumBit % 8, asi sacas la posición dentro del byte
		xor r17, r17, 7;				 Como está en orden mayor a menor, hay que invertirlo
		or r18, r0, 1;					 Iniciamos a 1 un registro para meterle el desplazamiento en el byte y la anchura

		mak r18, r18, 0<5>;				 En r18 hay un 1 en la posición 5, anchura de la extracción
		addu r18, r17, r18;				 Añado la posición del bit,como es un número entre 0 y , ocupa solo tres bits, no toca el bit 5 con el 1
		extu r29, r19, r18;				 Extraemos el bit en r29 directamente

		POP(r1)
		jmp(r1)

CoincidenCad:
        PUSH(r1)
        ld r20, r30, 4;                  r20 <- Puntero a cadena1
        ld r21, r30, 8;                  r20 <- Puntero a cadena2
        or r29, r0, r0 ;                 Iniciamos contador
SIGUECOINCAD:
        ld.bu r10, r20, r29;             Cargamos caracter de cadena 1
        ld.bu r11, r21, r29;             Cargamos caracter de cadena 2

        cmp r7, r10, r11;                Vemos si son iguales
        bb1 ne, r7, FINCOINCAD;          Si no son iguales hemos acabado

        cmp r7, r10, r0;                 Ya sabemos que son iguales, vemos si hemos acabado, con uno vale porque son iguales
        bb1 eq, r7, FINCOINCAD;          Si ambos osn 0, hemos agotado ambas, y cubrimos también si ambas son vacías

        addu r29, r29, 1;                 Aumentamos contador
        br SIGUECOINCAD;                 Iteramos de nuevo
FINCOINCAD:
        POP(r1);
        jmp(r1);


BuscaCar:
		PUSH(r1);							NOTA TEMPORAL, REVISAR PORQUE NO HAY COMPROBACIÓN DE DATOS VÁLIDOS, ASUME QUE FROM <= TO.
		ld r14, r30, 4;					 r14 <- c, el caracter a buscar
		ld r20, r30, 8;					 r20 <- puntero a ref, es por dirección

		ld r10, r30, 12;				 r10 <- from
		ld r11, r30, 16;				 r11 <- to

		or r29, r10,r0;					 r29 <- Inicio contador de movimiento ya en from, porque luego lo tendre que sumar

		addu r12, r20, r10;				 r12 <- ref[from], apunta a donde tenemos que empezar a buscar
		addu r13, r20, r11;				 r13 <- ref[to], apunta a la posición en la que paramos, esta no se mira, la ultima mirada es ref[to-1]

SigueBusca:
		cmp r7, r12, r13;
		bb1 eq, r7, NoEncontrado;		 Si he llegado al final, acabo

		ld.bu r2, r12, 0;				 Cargamos el char apuntado para comprobarlo
		cmp r7, r2, r14;				 Veo si el apuntado es C
		bb1 eq, r7, FinBusca;

		addu r29, r29, 1;				 Aumentamos contador
		addu r12, r12, 1;
		br SigueBusca;
NoEncontrado:
		or r29, r11, r0
FinBusca:
		POP(r1)
		jmp(r1)
Comprime:
		PUSH(r1)
		PUSH(r31)
		or r31, r30, r30;
		ld r20, r31, 8;					 r20 <- *texto
		PUSH(r20)

		bsr LongCad

		addu r30, r30, 4;				 Limpio pila
		mulu r29, r29, 4;				 nº bytes texto comprimido(Como máximo)
		addu r29, r29, 12;				 Reservo espacio para desplazamiento en texto, en pilaZona3 y en el mapa de bits
		subu r30, r30, r29;				 Reservo variables local

		ld r20, r31, 8;
		or r22, r30, r30;				 *pilaZona3

		ld r2, r20, 0;					 Cargo los primeros 4 chars de texto
		st r2, r22, 0;					 Los guardo
		ld r2, r20, 4;					 Repito con los 4 siguientes
		st r2, r22, 4;					 He copiado los 1x8 caracteres
		addu r2, r0, 8;					 Como he leido 8 bytes, ese es mi desplazamiento

		st r2, r31, -4;				     Nuevo puntero de texto
		st r2, r31, -8;				     Nuevo puntero de pilaZona3
		st r0, r31, -12;				 NumBit, ya estan todas las variables inicializadas
LLenado:
		ld r20, r31, 8
		ld r10, r31, -4
		ld.bu r2, r20, r10
		cmp r7,r2, r0;					 Vemos si hemos acabado texto
		bb1 eq, r7, FinLlenado

		ld r12, r31, -12
		divu r13, r12, 8
		mulu r14, r13, 8
		subu r12, r12, r14;				 Preparamos el %8

		cmp r7, r12, r0;				 Vemos si hay que inicializar
		bb1 ne, r7, NoInicia
		ld r22, r31, 12
		addu r22, r22, 5;				 Me salto la cabecera
		st.b r0, r22, r13
NoInicia:
		or r23, r0, r0;					 Inicio un registro de salida
		PUSH(r23)
		PUSH(r10)
		PUSH(r20)

		bsr BuscaMax
		
		addu r30, r30, 8;				 Limpio *texto y el desplazamiento, porque en una instrucción es más rápido aunque luego tenga que recuperarlo
		POP(r23)

		ld r20, r31, 8
		ld r10, r31, -4
		ld r11, r31, -8;
		ld r12, r31, -12;				 Preparo los desplazamientos antes para usarlos haya o no haya compresión

		cmp r7, r29, 4
		bb1 ge, r7, Compr

		ld r12, r31, -12;			 	 Este lo cargo aquí porque la llamada a PoneBitA1 se lo cargaría
		ld.bu r2, r20, r10
		st.b r2, r30, r11

		addu r10, r10, 1
		addu r11, r11, 1
		addu r12, r12, 1;				 Avanzamos los desplazamientos

		st r10, r31, -4
		st r11, r31, -8
		st r12, r31, -12;				 Guardamos todo

		br LLenado
Compr:
		extu r24, r23, 8<8>;			 Segundo byte
		st.b r24, r23, r11
		addu r11, r11, 1
		st.b r23, r30, r11;				 Guardo la dir P, media palabra
		addu r11, r11, 2
		st.b r29, r30, r11;				 Guardo un byte con L
		addu r11, r11, 1;				 Avanzo 3 el *pilaZona3
		addu r10, r10, r29;				 Avanzo L el *texto
		st r10, r31, -4
		st r11, r31, -8


		ld r22, r31, 12
		addu r22, r31, 5

		PUSH(r12)
		PUSH(r22)

		bsr PoneBitA1

		addu r30, r30, 8;				 Limpio pila
		ld r12, r31, -12;				 Numbit
		addu r12, r12, 1;				 Avanzo NumBit
		st r12, r31, -12;				 Guardo

		br LLenado
FinLlenado:
		ld r22, r31, 12;				 Numbit
		ld r10, r31, -4;				 Desplazamiento texto
		extu r11, r10, 8<8>
		st.b r11, r22, 0;				 Guardo primer byte del tamaño de texto
		st.h r10, r22, 1;				 Guardo segundo byte del tamaño de texto

		or r3, r0, 1;					 Creo un 1, que será M
		st.b r3, r22, 2;

		ld r12, r31, -12;
		addu r12, r12, 7;				 Redondeo
		divu r29, r12, 8;				 Saco el numero de bytes de Mapa de bits
		addu r29, r29, 5;				 + 5 de cabecera
		extu r28, r29, 8<8>;
		st.b r28, r22, 3;				 Guardo primer byte de el tamaño de cabecera + mapa de bits
		st.b r29, r22, 4;				 El segundo
		addu r22, r22, r29;				 *cmrpdo a final de mapa de bits
		ld r11, r31, -8
		addu r29, r29, r11;				 Valor de retorno ya listo, todos los byts de cmrpdo
		or r4, r0, r0;
Vaciado:
		cmp r7, r4, r11
		bb1 eq, r7, FinVaciado
		ld.bu r2, r30, r4
		st.b r2, r22, r4
		addu r4, r4, 1
		br Vaciado
FinVaciado:
		or r30, r31, r31
		POP(r31)
		POP(r1)
		jmp(r1)

		

		


		
		




Descomprime:
		PUSH(r1)
		PUSH(r31)
		or r31, r30, r30;
		ld r2, r30, 4; 					Cargo el puntero donde se recibe el texto compreso
		ld r3, r30, 8;					Creo el puntero a donde se almacenará el texto descompreso	
		or r29, r0, r0; 				creo el valor de r29 a 0, que será donde devolverá el temaño del texto
		
Verifica:
		jmp(r1)

PoneBitA1:
		PUSH(r1)
		ld r20,r30,4; 					cargo a r20 la dirección de donde se encuentran los bytes
		ld r15,r30,8; 					cargo el entero al registro 15

		divu r16,r15,8; 				averiguo en cual byte se encuentra el bit
		addu r20,r20,r16
		ld.bu r19, r20, r0
		or r18,r0,r0
		addu r18, r18, 1
		mak r18, r18,0<5>


		addu r16,r16,1
		mulu r16,r16,8
		subu r16,r16,1
		
		subu r17, r16,r15
		addu r18,r17,r18
		set r19, r19, r18
		st.b r19, r20, r0

		POP(r1)
		jmp(r1)
		
		

;
; Debe incorporar este fichero con TODAS sus l neas, sin modificar
; ninguna de ellas, al final de su archivo CDV24.ens
;
; Este aviso se refiere tambi n a las l neas de comentario
;
